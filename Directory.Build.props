<Project>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>vbfox</Authors>
    <Description>A command line editor for console applications (history, tab completion, key bindings): an F# port of Mono's getline.cs.</Description>
    <PackageProjectUrl>https://github.com/vbfox/FsGetLine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vbfox/FsGetLine.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageTags>F#;FSharp;console;readline;getline;line-editor</PackageTags>
  </PropertyGroup>

  <!-- Generated by the build script (GenerateVersionInfo task) from Release Notes.md -->
  <Import Project="$(MSBuildThisFileDirectory)artifacts/Version.props" Condition="exists('$(MSBuildThisFileDirectory)artifacts/Version.props')" />

</Project>
